TTS_RATE=170
AGENT_HOST=127.0.0.1
AGENT_ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8765
BRIDGE_TOKEN=
DATA_DIR=data
AUTO_MEMORY=true
MODEL_TIMEOUT=35
CAPTURE_TIMEOUT=45
TURN_TIMEOUT=150
MAX_STEPS=6
MAX_PENDING=3
LUMA_PYTHON_SCRIPT=
MODEL_RESPONSE_FORMAT=json_schema
MODEL_DISABLE_THINKING=false
